diff --git a/scripts/ci/cuda/ci_install_dependency.sh b/scripts/ci/cuda/ci_install_dependency.sh
index 3642bf85d..eb8bd5e99 100755
--- a/scripts/ci/cuda/ci_install_dependency.sh
+++ b/scripts/ci/cuda/ci_install_dependency.sh
@@ -470,7 +470,7 @@ require_prebuilt_rust_exts() {
     suffix=$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
     local missing=()
     local module
-    for module in server grpc multimodal; do
+    for module in server grpc multimodal storage; do
         [ -f "python/sglang/srt/rust_extensions/_${module}${suffix}" ] || missing+=("${module}")
     done
     if [ ${#missing[@]} -gt 0 ]; then
@@ -811,7 +811,7 @@ print(f"sglang resolves to {spec.origin}")
 # Import, not find_spec: the finders locate an extension without dlopening it,
 # so a .so that cannot load passes find_spec and only fails inside some suite.
 import importlib
-for mod in ("server", "grpc", "multimodal"):
+for mod in ("server", "grpc", "multimodal", "storage"):
     name = f"sglang.srt.rust_extensions._{mod}"
     try:
         importlib.import_module(name)
